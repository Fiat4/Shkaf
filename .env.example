# Скопируйте в .env в корне репозитория и заполните значения.
# cp .env.example .env

# --- Postgres ---
POSTGRES_USER=locker
POSTGRES_PASSWORD=change_me_strong_password
POSTGRES_DB=lockerwood
POSTGRES_PORT=5432

# --- Публичные URL ---
# API (куда браузер ходит за данными и откуда отдаются /uploads)
# Локально: http://localhost:3000
# Прод РФ:  https://api.ваш-домен.ru
URL=http://localhost:3000
REACT_APP_API_URL=http://localhost:3000

# Фронт origins через запятую (CORS)
# Локально: http://localhost,http://localhost:80
# Прод:     https://ваш-домен.ru,https://www.ваш-домен.ru
CORS_ORIGIN=http://localhost,http://localhost:80

# Если фронт и api на поддоменах одного домена — раскомментируйте:
# COOKIE_DOMAIN=.ваш-домен.ru

# --- Порты на хосте ---
API_PORT=3000
WEB_PORT=80

# --- Админ ---
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change_me_admin_password

# --- JWT ---
JWT_SECRET=change_me_access_secret_min_32_chars
JWT_REFRESH_SECRET=change_me_refresh_secret_min_32_chars
JWT_ACCESS_TOKEN_TTL=30m
JWT_REFRESH_TOKEN_TTL=14d

# --- Telegram ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_ADMIN_IDS=
# На РФ-сервере укажите URL прокси в KZ, например:
# TELEGRAM_API_ROOT=https://tg-proxy.ваш-kz-домен.kz
TELEGRAM_API_ROOT=https://api.telegram.org
